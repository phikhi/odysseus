#!/usr/bin/env bash
# Fake `curl` on PATH — stands in for GET /api/oauth/usage.
#
# Serves whatever `usage_respond` installed, honours `-o <file>`, records every
# invocation (so a test can assert the User-Agent the endpoint demands), and
# exits with whatever `usage_exit` asked for.
set -uo pipefail

state="${RALPH_SHIM_STATE:?curl shim: RALPH_SHIM_STATE is not set}"

{
  for arg in "$@"; do printf '%s ' "$arg"; done
  printf '\n'
} >>"$state/curl.calls"

out=""
prev=""
for arg in "$@"; do
  [ "$prev" = "-o" ] && out="$arg"
  prev="$arg"
done

body=""
[ -f "$state/curl.body" ] && body="$(cat "$state/curl.body")"

if [ -n "$out" ]; then
  printf '%s' "$body" >"$out"
else
  printf '%s' "$body"
fi

exit "$(cat "$state/curl.exit" 2>/dev/null || echo 0)"
