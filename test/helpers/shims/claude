#!/usr/bin/env bash
# Fake `claude` on PATH.
#
# Records argv and stdin (the prompt) so a test can assert what the loop asked
# for, then either runs the scenario the test installed via `script_claude` or
# emits a default stream-json success.
#
# The default stream is modelled on a real capture (claude 2.1.220, haiku):
# same event sequence, same keys on the final `result`, usage on the assistant
# events. That fidelity matters — the smart-zone net watches this stream for the
# soft token limit and the budget gate reads `rate_limit_event` out of it, so a
# stream invented here would have those features designed against a fiction.
# `test/contract-claude.bats` is what keeps the two aligned: it runs one set of
# assertions against this stream, and the same set against the real binary when
# a human asks for it. Re-capture with:
#
#   printf 'Reply with exactly PONG-1 and nothing else.\n' | claude -p \
#     --model haiku --output-format stream-json --verbose
#
# One thing a fake cannot reproduce: the real init event reports the model it
# *resolved* (`--model haiku` comes back as `claude-haiku-4-5-20251001`), where
# this echoes the argument it was given. Nothing in the pack reads that field, so
# the contract only asks that it be there and non-empty.
#
# Token counts are the fake's own: what has to be faithful is where a figure
# appears and what shape it has, not its magnitude. 1000 + 200 keeps every
# default-stream session comfortably under the soft limit.
set -uo pipefail

state="${RALPH_SHIM_STATE:?claude shim: RALPH_SHIM_STATE is not set}"
mkdir -p "$state/claude.calls"

# One slot per call, claimed with `mkdir` — which is the test-and-set, the same
# way the pack's own locks work.
#
# It used to be `n = $(cat count) + 1`, which is fine for as long as sessions are
# spawned one after another and a lie the moment they are not. [06] runs the review
# lenses as concurrent gate branches: every one of them read the same count, wrote
# the same slot, and clobbered the others' recorded prompt — so a test asking what
# the security lens was handed got whichever branch won, and a test counting the
# calls saw one. A fake that cannot count is worse than no fake, because it is
# green.
n=0
while :; do
  n=$((n + 1))
  if mkdir "$state/claude.calls/$n" 2>/dev/null; then
    break
  fi
  [ "$n" -lt 10000 ] || {
    printf 'claude shim: no free call slot\n' >&2
    exit 97
  }
done

: >"$state/claude.calls/$n/argv"
model="test-model"
want_model=0
# Derived from argv, never hard-coded: the contract asserts that a session runs
# with permissions bypassed, and a fake that answered `bypassPermissions`
# whatever it was called with would make that assertion vacuous.
permission_mode="default"
# Same discipline for the tool set. A session spawned without `--tools` gets the
# built-in set, which includes the ones that write; a review lens is spawned with
# `--tools` and gets exactly what it asked for ([06]). A fake that always reported
# `[]` would make "the lens has no write tool" pass without anything being true.
#
# The real binary's list is longer than this and moves between releases. Only two
# things about it are under contract: that it is there, and that a session given
# `--tools` comes back with that set and nothing else.
tools="Task,Bash,Glob,Grep,Read,Edit,Write,NotebookEdit,WebFetch,WebSearch,TodoWrite"
want_tools=0
# Same discipline again, for the two channels `--tools` does not govern ([31]).
# What the real binary does with the tree it starts in, probed on 30/07/2026:
# a project `.mcp.json` gets its server `command` launched and its tools offered
# to the model — even under `--tools` — and a hook declared in the project's
# settings runs on the first tool call. Neither is a tool, so neither was covered.
#
# `mcp_servers` is the one of the two the real init event reports, so it is the
# one this fake can answer faithfully: non-empty when a project `.mcp.json` is
# there and `--strict-mcp-config` was not passed. `--setting-sources` has no
# observable in init at all — `memory_paths` came back identical either way — so
# what the fake can honestly do is record what it *would* have loaded and let a
# test assert that a lens loads nothing. The real-binary half of both is in
# test/contract-claude.bats, where a hook and a server command leave a marker on
# disk and no model has to be believed.
strict_mcp=0
setting_sources="user,project,local"
want_sources=0
for arg in "$@"; do
  printf '%s\n' "$arg" >>"$state/claude.calls/$n/argv"
  if [ "$want_model" = 1 ]; then
    model="$arg"
    want_model=0
  fi
  if [ "$want_tools" = 1 ]; then
    tools="$arg"
    want_tools=0
  fi
  if [ "$want_sources" = 1 ]; then
    setting_sources="$arg"
    want_sources=0
  fi
  [ "$arg" = "--model" ] && want_model=1
  [ "$arg" = "--tools" ] && want_tools=1
  [ "$arg" = "--setting-sources" ] && want_sources=1
  [ "$arg" = "--strict-mcp-config" ] && strict_mcp=1
  [ "$arg" = "--dangerously-skip-permissions" ] && permission_mode="bypassPermissions"
done

# The project MCP servers this session loaded, reported the way the real init
# event reports them: `[{"name":"<name>","status":"pending"}]`, one entry per key
# under `mcpServers`. A crude read of the file on purpose — the pack promises to
# run with nothing installed, and this fake has no more right to jq than it does.
# Whitespace is stripped first, so a one-line `.mcp.json` — which is how most of
# them are written — reads the same as an indented one. A server key is a quoted
# name followed by an object; nothing else in these files has that shape.
mcp_json="[]"
if [ "$strict_mcp" = 0 ] && [ -f "$PWD/.mcp.json" ]; then
  entries="$(tr -d ' \t\n' <"$PWD/.mcp.json" |
    sed -n 's/.*"mcpServers":{//p' |
    grep -o '"[A-Za-z0-9_-]*":{' |
    tr -d '":{' |
    awk '{ printf "%s{\"name\":\"%s\",\"status\":\"pending\"}", (NR > 1 ? "," : ""), $0 }')" ||
    entries=""
  if [ -n "$entries" ]; then
    mcp_json="[$entries]"
    printf '%s\n' ".mcp.json" >"$state/claude.calls/$n/mcp-loaded"
  fi
fi

# What the project side of the tree would have contributed: settings (hooks,
# permissions, env) and CLAUDE.md. Recorded, never executed — a fake that ran a
# hook out of the tree under test would be a fake with a shell in it.
record_config() {
  local f
  for f in "$@"; do
    [ -f "$PWD/$f" ] || continue
    printf '%s\n' "$f" >>"$state/claude.calls/$n/project-config"
  done
}
case ",$setting_sources," in
  *,project,*) record_config .claude/settings.json CLAUDE.md ;;
esac
case ",$setting_sources," in
  *,local,*) record_config .claude/settings.local.json CLAUDE.local.md ;;
esac

tools_json="$(printf '%s' "$tools" |
  awk -F, '{ for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), $i }')"

# The environment the loop spawned us with — the auto-compact posture is only
# assertable from here.
env >"$state/claude.calls/$n/env"

# Never block on a terminal: a test may run the loop without a pipe on stdin.
if [ -t 0 ]; then
  : >"$state/claude.calls/$n/stdin"
else
  cat >"$state/claude.calls/$n/stdin"
fi

if [ -x "$state/claude.script" ]; then
  exec "$state/claude.script" "$@" <"$state/claude.calls/$n/stdin"
fi

session="test-session-$n"

# Scriptable so a budget test can drive the in-band signal. resetsAt is an
# epoch, here far in the future.
rate_limit="$(cat "$state/claude.rate_limit" 2>/dev/null || true)"
[ -n "$rate_limit" ] || rate_limit='{"status":"allowed","resetsAt":4102444800,"rateLimitType":"five_hour","overageStatus":"rejected","overageDisabledReason":"group_zero_credit_limit","isUsingOverage":false}'

# What the session "replied". The real binary puts its answer in the result
# event's `result` field, which is how the contract proves the prompt on stdin
# was received at all ([20]): it asks for a marker and looks for it there. The
# fake earns the same assertion the same way — by reading the marker out of the
# prompt it was handed — rather than by being told the answer.
answer="$(sed -n 's/.*Reply with exactly \([A-Za-z0-9_-]*\).*/\1/p' \
  "$state/claude.calls/$n/stdin" 2>/dev/null | head -1)"

# A review lens asks a different question, so the fake recognises the question
# rather than being told which call it is on: a prompt that asks for a verdict line
# gets one. Same rule as the model and the permission mode — derived from what the
# pack actually sent.
#
# The name comes out of the prompt too, which is what lets a test say "the security
# lens failed" without knowing what order the branches were started in. `pass`
# unless a test asked otherwise, so the whole suite is not obliged to script a
# verdict for a tier most of its files run with switched off.
lens=""
if grep -q 'RALPH-LENS-VERDICT' "$state/claude.calls/$n/stdin" 2>/dev/null; then
  lens="$(sed -n 's/^## The lens you are: \(.*\)$/\1/p' \
    "$state/claude.calls/$n/stdin" 2>/dev/null | head -1)"
fi

if [ -n "$lens" ]; then
  mkdir -p "$state/claude.lenses"
  printf '%s\n' "$n" >>"$state/claude.lenses/$lens"

  # A lens the API refused ([43]): the in-band event, no verdict, and a non-zero
  # exit. Written here rather than through `script_claude` for the reason
  # `lens-*.writes` is: a script replaces the whole fake, so a test that scripted a
  # refused lens would lose the verdicts of the lenses beside it and would be
  # measuring that instead. The stream stops at the event, which is what a session
  # that never started emits — the delivery half of the same case is
  # `script_refused_session` in test/budget.bats.
  if [ -f "$state/lens-$lens.refused" ]; then
    printf '{"type":"system","subtype":"init","session_id":"%s","model":"%s"}\n' \
      "$session" "$model"
    printf '{"type":"rate_limit_event","rate_limit_info":%s,"uuid":"uuid-%s-rate","session_id":"%s"}\n' \
      "$(cat "$state/lens-$lens.refused")" "$n" "$session"
    exit 1
  fi

  verdict="$(cat "$state/lens-$lens.verdict" 2>/dev/null ||
    cat "$state/lens.verdict" 2>/dev/null || echo pass)"

  # A lens that writes in the tree it is judging: the case [06] has to contain,
  # and one only a fake can stage on demand. Paths are relative to the working
  # directory the branch was started in, which is the project root.
  if [ -f "$state/lens-$lens.writes" ]; then
    while IFS= read -r target; do
      [ -n "$target" ] || continue
      mkdir -p "$(dirname "$target")"
      printf 'written by the %s lens\n' "$lens" >"$target"
    done <"$state/lens-$lens.writes"
  fi

  # A lens that closes the instrument the gate measures its writes with ([34]):
  # the pinned ignore rules, without which `gate_tree_snapshot` refuses to hand a
  # tree back at all. A hook rather than a scripted scenario, and only for a lens:
  # a delivery session can be scripted whole, where scripting a lens would take the
  # verdict handling with it and measure that instead.
  #
  # The directory to sweep is named by the test rather than globbed out of the
  # machine's `$TMPDIR` — the harness assumes concurrent runners, and a fake that
  # deleted every pin it could find would take down the suite running beside it.
  if [ -f "$state/lens-$lens.closes-measurement" ]; then
    rm -rf "$(cat "$state/lens-$lens.closes-measurement")"/ralph-ignore.* 2>/dev/null || true
  fi

  # `silent` is a lens that reviewed and never said what it decided — the case the
  # gate has to count red, and the one a verdict of `garbage` does not cover.
  if [ "$verdict" = silent ]; then
    answer="findings from the $lens lens: none."
  else
    answer="findings from the $lens lens: none. RALPH-LENS-VERDICT: $verdict"
  fi

# A delivery session that actually writes its write-surface. It lives here rather
# than in a `script_claude` scenario because a script replaces the whole fake,
# verdict handling included: a test that scripted a writing session would get
# lenses that answer nothing, and would be measuring that instead of what it
# meant to.
#
# The default since [35], where it used to be opt-in, and the flip is the finding
# rather than a convenience. An iteration the gate sees change no file is red now,
# whatever its tests say — so a fake that wrote nothing no longer models a
# cooperative session, it models the one failure this pack exists to refuse, and
# every green in this suite would have been measuring that instead. A test that
# wants the empty case asks for it: `session_writes_nothing`.
elif [ ! -f "$state/session.silent" ]; then
  # An empty list means "whatever this ticket declared", read out of the prompt the
  # way the canary's honest session reads it. That is the faithful default: a test
  # driving two tickets at once must not have to hand-list both surfaces, and one
  # that did would be writing into the other ticket's surface and measuring drift.
  targets="$(cat "$state/session.writes" 2>/dev/null || true)"
  [ -n "$targets" ] || targets="$(sed -n 's/^\*\*Write-surface:\*\* //p' \
    "$state/claude.calls/$n/stdin" | head -1 | tr -d '`\r' | tr ',' '\n')"
  # `read` without `IFS=`, which is the one place in this file that is deliberate:
  # a surface is written `\`a\`, \`b\`` for a human, so splitting it on the comma
  # leaves a leading space on every entry but the first. A session that wrote
  # ` src/eta.txt` would be overflowing its own write-surface — the pack reads a
  # surface by whitespace and cannot express a path with a space in it either.
  printf '%s\n' "$targets" | while read -r target; do
    [ -n "$target" ] || continue
    mkdir -p "$(dirname "$target")"
    printf 'written by the session\n' >"$target"
  done
fi

[ -n "$answer" ] || answer=done

# The event sequence of the capture, in its order: the first thinking estimate
# lands before the budget event, not after it. Both assistant events carry
# `message.usage` — that is where the smart-zone net gets its signal *while the
# session is still running*. A fake that reported usage only on the final result
# would let the net look covered while it could only ever fire after the fact.
cat <<EOF
{"type":"system","subtype":"init","cwd":"$PWD","session_id":"$session","uuid":"uuid-$n-init","model":"$model","permissionMode":"$permission_mode","apiKeySource":"none","claude_code_version":"0.0.0-shim","output_style":"default","tools":[$tools_json],"mcp_servers":$mcp_json,"slash_commands":[],"agents":[],"skills":[],"plugins":[],"memory_paths":[],"capabilities":[],"analytics_disabled":true,"product_feedback_disabled":true,"fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required"}
{"type":"system","subtype":"thinking_tokens","estimated_tokens":3,"estimated_tokens_delta":3,"uuid":"uuid-$n-think1","session_id":"$session"}
{"type":"rate_limit_event","rate_limit_info":$rate_limit,"uuid":"uuid-$n-rate","session_id":"$session"}
{"type":"system","subtype":"thinking_tokens","estimated_tokens":36,"estimated_tokens_delta":33,"uuid":"uuid-$n-think2","session_id":"$session"}
{"type":"assistant","message":{"model":"$model","id":"msg-$n","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"one thought","signature":"sig-$n"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1000,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":200,"service_tier":"standard"}},"parent_tool_use_id":null,"request_id":"req-$n","session_id":"$session","uuid":"uuid-$n-think-msg","timestamp":"2026-07-25T00:00:00.000Z"}
{"type":"assistant","message":{"model":"$model","id":"msg-$n","type":"message","role":"assistant","content":[{"type":"text","text":"$answer"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1000,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":200,"service_tier":"standard"}},"parent_tool_use_id":null,"request_id":"req-$n","session_id":"$session","uuid":"uuid-$n-msg","timestamp":"2026-07-25T00:00:00.000Z"}
{"type":"result","subtype":"success","is_error":false,"result":"$answer","session_id":"$session","uuid":"uuid-$n-result","num_turns":2,"duration_ms":1000,"duration_api_ms":900,"ttft_ms":100,"ttft_stream_ms":90,"time_to_request_ms":10,"total_cost_usd":0.01,"stop_reason":"end_turn","terminal_reason":"completed","api_error_status":null,"permission_denials":[],"fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","usage":{"input_tokens":1000,"output_tokens":200,"cache_read_input_tokens":0,"cache_creation_input_tokens":0,"service_tier":"standard"},"modelUsage":{"$model":{"inputTokens":1000,"outputTokens":200,"costUSD":0.01,"contextWindow":200000}}}
EOF
